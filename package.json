{
  "name": "jungle-gaming-wagering-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:concurrency": "bun run scripts/concurrency-smoke.ts",
    "test:multi-instance": "bun run scripts/multi-instance-smoke.ts",
    "db:migrate": "mikro-orm migration:up",
    "db:migrate:down": "mikro-orm migration:down",
    "db:migrate:status": "mikro-orm migration:list",
    "sqs:setup": "bun run scripts/setup-sqs.ts",
    "sqs:inspect": "bun run scripts/inspect-sqs.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1178.0",
    "@mikro-orm/cli": "7.2.12",
    "@mikro-orm/core": "7.2.12",
    "@mikro-orm/decorators": "7.2.12",
    "@mikro-orm/migrations": "7.2.12",
    "@mikro-orm/nestjs": "7.0.1",
    "@mikro-orm/postgresql": "7.2.12",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@mikro-orm/reflection": "7.2.12"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx"
  }
}
